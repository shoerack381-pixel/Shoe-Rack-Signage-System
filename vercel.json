{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin_out/(.*)", "destination": "/admin_out/$1" },
    { "source": "/admin/assets/(.*)", "destination": "/admin_out/assets/$1" },
    { "source": "/admin/favicon.svg", "destination": "/admin_out/favicon.svg" },
    { "source": "/admin/icons.svg", "destination": "/admin_out/icons.svg" },
    { "source": "/admin", "destination": "/admin_out/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin_out/index.html" }
  ]
}
