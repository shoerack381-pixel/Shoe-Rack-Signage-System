{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/assets/(.*)", "destination": "/admin/dist/assets/$1" },
    { "source": "/admin/favicon.svg", "destination": "/admin/dist/favicon.svg" },
    { "source": "/admin/icons.svg", "destination": "/admin/dist/icons.svg" },
    { "source": "/admin", "destination": "/admin/dist/index.html" },
    { "source": "/admin/(?!assets|dist|favicon\\.svg|icons\\.svg)(.*)", "destination": "/admin/dist/index.html" }
  ]
}
